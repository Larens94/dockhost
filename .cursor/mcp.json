{
    "mcpServers": {
        "dokhosts-dokploy": {
            "type": "stdio",
            "command": "node",
            "args": [
                "mcp/dokploy/server.mjs"
            ],
            "env": {
                "DOKHOSTS_ROOT": "e:/OFFICE/silicore/dockhost",
                "CURSOR_PROJECT_DIR": "e:/OFFICE/silicore/dockhost"
            },
            "envFile": "e:/OFFICE/silicore/dockhost/.env"
        }
    }
}
